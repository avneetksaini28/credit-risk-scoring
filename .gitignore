__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
build/
dist/

# Environment / secrets
.env
kaggle.json
.venv/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Tableau lock / temp files
~*.twbr
*.hyper
.virtual_documents/
