# Data and generated artifacts (Kaggle terms do not allow redistributing the data)
data/raw/*
data/interim/*
data/processed/*
data/sample/*
database/*
models/*
!**/.gitkeep
# reports/ (figures, metrics, aggregated SQL results) is committed on purpose: it is small and
# contains no row-level customer data, and the README links to the figures.

